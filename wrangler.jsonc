{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokyo-gang",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "minify": true,
  "vars": {
    "ADMIN_DASHBOARD_PAGE_SIZE": "24",
    "ADMIN_ACTIVITY_WINDOW_DAYS": "7",
    "TOKYO_MEMBER_SYNC_INTERVAL_SECONDS": "60"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tokyo-gang"
    }
  ],
  "routes": [
    {
      "pattern": "tokyo-gang.com",
      "custom_domain": true
    },
    {
      "pattern": "www.tokyo-gang.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
